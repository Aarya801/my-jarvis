AI_MODE=auto
LOCAL_AI_PROVIDER=ollama
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=qwen2.5:3b
# Optional: an Ollama vision model. Screen capture runs only on an explicit command.
VISION_MODEL=
CLOUD_AI_PROVIDER=openai
CLOUD_AI_API_KEY=
# Used only when CLOUD_AI_API_KEY is configured. The model may use web search for current questions.
CLOUD_AI_MODEL=gpt-5
PRIVACY_MODE=false
PERFORMANCE_MODE=balanced
TTS_ENABLED=true
STT_ENABLED=false
# Push-to-talk only; no continuous microphone recording or wake-word listener.
VOICE_ENABLED=true
WAKE_WORD=jarvis
MEMORY_ENABLED=false
